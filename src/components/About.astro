---
import styles from './About.module.css'

const valores = [
  {
    titulo: "Confianza",
    descripcion: "Tu información es tratada con la máxima discreción y responsabilidad.",
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    titulo: "Puntualidad",
    descripcion: "Cumplimos cada vencimiento y entregamos siempre a tiempo, sin sorpresas.",
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
  {
    titulo: "Claridad",
    descripcion: "Explicamos todo en lenguaje simple para que siempre sepas cómo estás.",
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  },
  {
    titulo: "Compromiso",
    descripcion: "Nos involucramos con tu proyecto como si fuera el nuestro propio.",
    icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];

const stats = [
  { num: "+20", label: "Años de experiencia" },
  { num: "+150", label: "Clientes activos" },
  { num: "100%", label: "Cumplimiento fiscal" },
  { num: "3", label: "Profesionales del equipo" },
];
---

<section class={styles.abSection} id="sobre-nosotros">
  <span class={styles.abBadge}>Quiénes somos</span>

  <h2 class={styles.abHeading}>
    Contadores que entienden<br />
    tu <em>negocio</em>, no solo tus números.
  </h2>

  <p class={styles.abIntro}>
    Somos un estudio contable con más de 15 años de experiencia acompañando emprendedores, profesionales y empresas, liderado por Sergio Zárate, Contador Público egresado de la Universidad Nacional de Lomas de Zamora, quien a lo largo de su profesión se ha capacitado y especializado en el sistema tributario de Agencias de Viajes y Turismo, lo que lo lleva a la actualidad a complementar su actividad profesional con el dictado de clases en Instituciones Terciarias y Universitarias en carreras de Tecnicaturas y Licenciaturas en Turismo, en materias de Contabilidad, Costos, Impuestos, Economía, Administración y Gestión en Empresas del Sector Turístico. Creemos que una buena contabilidad no es solo cumplir con las obligaciones fiscales — es la base para tomar mejores decisiones y crecer con confianza.
  </p>

  <div class={styles.abValores}>
    {valores.map((v) => (
      <div class={styles.abValor}>
        <div class={styles.abValorIcon} set:html={v.icono} />
        <p class={styles.abValorTitle}>{v.titulo}</p>
        <p class={styles.abValorDesc}>{v.descripcion}</p>
      </div>
    ))}
  </div>

  <div class={styles.abDivider} />

  <div class={styles.abStats}>
    {stats.map((s) => (
      <div class={styles.abStat}>
        <div class={styles.abStatNum}>{s.num}</div>
        <div class={styles.abStatLabel}>{s.label}</div>
      </div>
    ))}
  </div>
</section>
