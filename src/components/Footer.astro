---
import styles from './Footer.module.css'
const year = new Date().getFullYear()
---
<footer class={styles.footer} data-reveal>
    <p class={styles.copy}>
        &copy; {year} Estudio Contable SZ. Todos los derechos reservados.
    </p>
    <nav class={styles.legal} aria-label="Enlaces legales">
        <a href="/privacidad">Política de privacidad</a>
    </nav>
    <p class={styles.dataFiscal}>
        Sergio Omar Zarate &middot; CUIT 20-29027177-1
    </p>
    <a
        class={styles.fiscalQr}
        href="http://qr.afip.gob.ar/?qr=zUPDabSOKnhNpakZyh6UeQ,,"
        target="_blank"
        rel="noopener noreferrer"
    >
        <img
            src="https://www.afip.gob.ar/images/f960/DATAWEB.jpg"
            alt="Data Fiscal AFIP"
            width="239"
            height="327"
            loading="lazy"
            decoding="async"
        />
    </a>
</footer>
