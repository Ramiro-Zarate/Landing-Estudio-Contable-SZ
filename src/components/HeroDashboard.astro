---
import styles from './Hero.module.css'
import LogoMark from './LogoMark.astro'

const servicios = ['IVA', 'Sueldos', 'Ingresos Brutos', 'Balance']
---

<div class={styles.dashStack} aria-hidden="true">
    <div class={`${styles.card} ${styles.cardList}`}>
        <ul class={styles.list}>
            {servicios.map((servicio) => (
                <li class={styles.listItem}>
                    <svg class={styles.check} viewBox="0 0 16 16" aria-hidden="true">
                        <circle cx="8" cy="8" r="8" />
                        <path d="M4.6 8.2 L6.9 10.5 L11.4 5.9" />
                    </svg>
                    {servicio}
                </li>
            ))}
        </ul>
    </div>
    <div class={`${styles.card} ${styles.cardDocs}`}>
        <svg class={styles.docIcon} viewBox="0 0 48 52" aria-hidden="true">
            <rect class={styles.docPaperBack} x="12" y="8" width="28" height="36" rx="4" />
            <rect class={styles.docPaper} x="6" y="4" width="28" height="36" rx="4" />
            <path class={styles.docFold} d="M26 4 V12 H34" />
            <line class={styles.docLine} x1="11" y1="18" x2="29" y2="18" />
            <line class={styles.docLine} x1="11" y1="24" x2="25" y2="24" />
        </svg>
    </div>
    <div class={`${styles.card} ${styles.cardMain}`}>
        <span class={styles.cardLabel}>Vencimientos</span>
        <div class={styles.calendar}>
            {Array.from({ length: 28 }).map((_, i) => (
                <span
                    class={i === 5 || i === 12 || i === 19 || i === 24 ? `${styles.calDay} ${styles.calDayOn}` : styles.calDay}
                />
            ))}
        </div>
    </div>
    <div class={`${styles.card} ${styles.cardBars}`}>
        <span class={styles.cardLabel}>Balance</span>
        <svg class={styles.donut} viewBox="0 0 42 42" aria-hidden="true">
            <circle class={styles.donutTrack} cx="21" cy="21" r="15.9" />
            <circle class={styles.donutArc} cx="21" cy="21" r="15.9" />
        </svg>
    </div>
    <div class={`${styles.card} ${styles.cardCrest}`}>
        <LogoMark />
    </div>
</div>
