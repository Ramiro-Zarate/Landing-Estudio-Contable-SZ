---
import '../styles/global.css';
import WhatsappButton from '../components/WhatsappButton.astro';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';

const { seo } = Astro.props;

const defaultSeo = {
    title: 'Estudio Contable SZ | Asesoría Contable, Impositiva y Laboral',
    description: 'En Estudio Contable SZ, ofrecemos servicios contables y fiscales personalizados para pequeñas y medianas empresas. Nuestro equipo de expertos se dedica a ayudarte a alcanzar tus objetivos financieros con soluciones integrales y un enfoque centrado en el cliente.',
};

const finalSeo = { ...defaultSeo, ...(seo ?? {}) };
---
<!doctype html>
<html lang="es-AR">
	<head>
		<script is:inline>document.documentElement.classList.add('js');</script>
		<Seo {...finalSeo} />
		<Analytics />
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/space-grotesk-700.woff2">
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-var.woff2">
		<link rel="preload" as="image" href="/fondo_hero.webp" type="image/webp" fetchpriority="high" />
	</head>
	<body>
		<slot />
		<WhatsappButton />
		<script>
			const revealTargets = document.querySelectorAll('[data-reveal]');
			const countTargets = document.querySelectorAll('[data-count]');
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const showFinal = (el) => {
				el.textContent = `${el.dataset.prefix ?? ''}${el.dataset.to}${el.dataset.suffix ?? ''}`;
			};

			const countUp = (el) => {
				const to = Number(el.dataset.to);
				const prefix = el.dataset.prefix ?? '';
				const suffix = el.dataset.suffix ?? '';
				const duration = 1100;
				const start = performance.now();

				const tick = (now) => {
					const progress = Math.min((now - start) / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);
					el.textContent = `${prefix}${Math.round(to * eased)}${suffix}`;
					if (progress < 1) requestAnimationFrame(tick);
				};

				requestAnimationFrame(tick);
			};

			if (reduce || !('IntersectionObserver' in window)) {
				revealTargets.forEach((el) => el.classList.add('is-revealed'));
				countTargets.forEach(showFinal);
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-revealed');
							observer.unobserve(entry.target);
						}
					},
					{ rootMargin: '0px 0px -10% 0px', threshold: 0.15 }
				);

				const countObserver = new IntersectionObserver(
					(entries, observer) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							countUp(entry.target);
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.4 }
				);

				revealTargets.forEach((el) => revealObserver.observe(el));
				countTargets.forEach((el) => countObserver.observe(el));
			}
		</script>
	</body>
</html>
