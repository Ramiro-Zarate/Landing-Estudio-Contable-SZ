---
import '../styles/global.css';
import WhatsappButton from '../components/WhatsappButton.astro';
import Seo from '../components/Seo.astro';

const { seo } = Astro.props;

const defaultSeo = {
    title: 'Estudio Contable SZ | Asesoría Contable, Impositiva y Laboral',
    description: 'En Estudio Contable SZ, ofrecemos servicios contables y fiscales personalizados para pequeñas y medianas empresas. Nuestro equipo de expertos se dedica a ayudarte a alcanzar tus objetivos financieros con soluciones integrales y un enfoque centrado en el cliente.',
};

const finalSeo = { ...defaultSeo, ...(seo ?? {}) };
---
<!doctype html>
<html lang="es">
	<head>
		<Seo {...finalSeo} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
		<link rel="preload" as="image" href="/fondo_hero.webp" type="image/webp" fetchpriority="high" />
	</head>
	<body>
		<slot />
		<WhatsappButton />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
