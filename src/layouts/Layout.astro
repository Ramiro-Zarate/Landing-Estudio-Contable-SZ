---
import '../styles/global.css';
import WhatsappButton from '../components/WhatsappButton.astro';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';

const { seo } = Astro.props;

const defaultSeo = {
    title: 'Estudio Contable SZ | Asesoría Contable, Impositiva y Laboral',
    description: 'En Estudio Contable SZ, ofrecemos servicios contables y fiscales personalizados para pequeñas y medianas empresas. Nuestro equipo de expertos se dedica a ayudarte a alcanzar tus objetivos financieros con soluciones integrales y un enfoque centrado en el cliente.',
};

const finalSeo = { ...defaultSeo, ...(seo ?? {}) };
---
<!doctype html>
<html lang="es-AR">
	<head>
		<Seo {...finalSeo} />
		<Analytics />
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/space-grotesk-700.woff2">
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-var.woff2">
	</head>
	<body>
		<slot />
		<WhatsappButton />
	</body>
</html>
